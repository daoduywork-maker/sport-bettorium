# shared figure style for every figure in this project (same font, sizes, line widths)
font.family: DejaVu Sans
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
axes.linewidth: 0.8
lines.linewidth: 1.8
lines.markersize: 5
axes.grid: True
grid.alpha: 0.3
axes.spines.top: False
axes.spines.right: False
figure.dpi: 150
savefig.dpi: 200
savefig.bbox: tight
